# --- MongoDB (used by docker-compose.yml) ---
MONGO_ROOT_USER=offroute
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DB=offroute

# --- Backend runtime ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
# Comma-separated allowed browser origins (prod is same-origin, so this is belt-and-braces)
CORS_ORIGIN=https://offroute.run
